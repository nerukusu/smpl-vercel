# One secret you choose. Used for Windows device pairing and ChatGPT OAuth approval.
SMPL_OWNER_SECRET=change-this-to-a-strong-password

# Supabase project URL and server-only secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Optional: pin ChatGPT to one registered device ID.
# SMPL_DEVICE_ID=your-device-id

# Optional: force the canonical public URL used for OAuth metadata.
# SMPL_PUBLIC_URL=https://your-vercel-domain.vercel.app
