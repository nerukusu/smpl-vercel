# One secret you choose. Used only for device pairing and OAuth approval.
SMPL_OWNER_SECRET=change-this-to-a-strong-password

# Upstash Redis REST credentials. Vercel KV-compatible names are also accepted.
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: pin ChatGPT to one registered device ID.
# SMPL_DEVICE_ID=your-device-id
